<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __PYTHON__, __REPO__ and __HOME__ (see README, "Run at login"). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.iec-kaifa-p1-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-I</string>
    <string>__REPO__/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/iec-kaifa-p1-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/iec-kaifa-p1-dashboard.log</string>
</dict>
</plist>
